# Copy to .env and fill in. Without OPENAI_API_KEY the assistant runs in offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# LLM_PROVIDER=openai          # or "offline"; defaults to openai when a key is set
# OFFLINE_EMBEDDINGS=false     # true = local hashing embeddings, no API calls

# RAG
DOCS_DIR=data/sample_docs
INDEX_PATH=data/index.json
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Agent
MAX_AGENT_STEPS=5
HISTORY_TURNS=6

# Integrations
API_KEY=                       # if set, callers must send header X-API-Key
POWER_AUTOMATE_WEBHOOK_URL=    # HTTP-trigger URL of the "create ticket" flow
TEAMS_WEBHOOK_SECRET=          # security token shown when creating the Teams outgoing webhook
BATCH_WORKERS=4
